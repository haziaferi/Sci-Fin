# build outputs and caches (regenerated by Gradle)
native/build/
native/*/build/
native/.gradle/
native/.kotlin/
*.apk
*.aab
# machine-local
native/local.properties
**/local.properties
.idea/
*.iml
desktop.ini
.claude/settings.local.json
__pycache__/
.semgrep/

# secrets and signing -- never in a public repository
.env
.env.*
*.jks
*.keystore
*.p12
*.pem
keystore.properties
signing.properties
google-services.json

# personal data: exported backups from a real device, and anything else a profile holds
design/phone-backup-*.json
*.scifin-backup.json

# local working copies and scratch (snapshots, cleanup notes, dated scratch passes)
_snapshots/
_cleanup-*/
design/scratch-*/

# screen-axis-harvest: the raw inventory names every project on the machine; the committed
# per-group files are redacted with ~/.claude/skills/screen-axis-harvest/redact.py
design/axis-harvest-*/inventory.json

# feature map: kept local, it describes private projects in detail
design/feature-map.json
design/feature-map.md
tools/feature_map.py

# device records: they name the owner's phones (model and build), so they stay local
design/Sci-Fin on the Phone.html
design/critique-2026-09-15.md
design/audit-2026-09-25.md
design/axis-harvest-2026-10-14/scifin_baseline.json
design/refs-apps/income-bc-1.png
design/refs-apps/income-bc-1.xml
